: 2px solid var(--line)}\n    thead th.mark {background: var(--orange)}\n    tbody th {font-weight: 700;white-space: nowrap;background: var(--orange-soft)}\n    tbody tr:last-child th,\n    tbody tr:last-child td {border-bottom: none}\n    .price {font-size: 1.4rem;font-weight: 800;display: block;line-height: 1.2}\n    .price-sub {font-size: 0.8rem;color: var(--muted);font-weight: 400}\n    .pick {display: inline-block;font-size: 0.72rem;letter-spacing: 0.1em;background: var(--orange);color: #fff;padding: 2px 8px;margin-bottom: 6px}\n    .table-note {margin: 16px 0 0;font-size: 0.86rem;color: var(--muted);max-width: 62em}\n\n    .grid-two {display: grid;grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));gap: 22px}\n    .note-card {border: 2px solid var(--line);background: var(--paper);padding: 22px 22px 24px}\n    .note-card h3 {margin: 0 0 10px;font-size: 1.1rem}\n    .note-card p {margin: 0 0 10px;font-size: 0.94rem;color: #333}\n    .note-card p:last-child {margin-bottom: 0}\n    .note-card ul {margin: 0;padding-left: 18px;font-size: 0.94rem;color: #333}\n    .note-card li {margin-bottom: 6px}\n\n    .faq-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));gap: 0;border-top: 2px solid var(--line);border-left: 2px solid var(--line)}\n    .qa {border-right: 2px solid var(--line);border-bottom: 2px solid var(--line);padding: 22px 22px 24px;background: var(--paper)}\n    .qa h3 {margin: 0 0 8px;font-size: 1rem;display: flex;gap: 10px;align-items: baseline}\n    .qa h3 .q {color: var(--orange);font-weight: 800;font-size: 0.86rem;letter-spacing: 0.06em}\n    .qa p {margin: 0;font-size: 0.93rem;color: #3a3a3a}\n\n    .clients {display: grid;grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));gap: 0;border: 2px solid var(--line)}\n    .client {padding: 20px 20px 22px;border-right: 2px solid var(--line);border-bottom: 2px solid var(--line)}\n    .client h3 {margin: 0 0 6px;font-size: 1rem}\n    .client p {margin: 0 0 6px;font-size: 0.9rem;color: var(--muted)}\n    .client .status {font-size: 0.78rem;letter-spacing: 0.06em;color: var(--orange);font-weight: 700}\n\n    footer {padding: 34px 46px 44px;border-top: 2px solid var(--line);background: var(--ink);color: #efefef;font-size: 0.86rem}\n    footer strong {color: #fff}\n    footer p {margin: 6px 0 0;max-width: 52em}\n\n    @media (max-width: 860px) {\n      .shell {grid-template-columns: 1fr}\n      .rail {position: static;height: auto;border-right: none;border-bottom: 2px solid var(--line);padding: 18px 20px;gap: 14px}\n      .rail nav ul {flex-direction: row;flex-wrap: wrap;gap: 4px}\n      .rail nav a {border-left: none;border-bottom: 2px solid transparent;padding: 6px 10px;font-size: 0.88rem}\n      .rail-note {display: none}\n      .hero, section, footer {padding-left: 20px;padding-right: 20px}\n      .hero {padding-top: 24px}\n      .hero-lower {grid-template-columns: 1fr;gap: 26px}\n      .step {border-right: none;border-bottom: 2px solid var(--line)}\n      .step:last-child {border-bottom: none}\n    }\n  </style><div class=\"shell\">\n  <aside class=\"rail\">\n    <div class=\"rail-brand\">Maosu<span>MAOSU / 服务说明</span></div>\n    <nav aria-label=\"页面目录\">\n      <ul>\n        <li><a href=\"#how\">怎么开始用</a></li>\n        <li><a href=\"#plans\">套餐对比</a></li>\n        <li><a href=\"#clients\">客户端情况</a></li>\n        <li><a href=\"#care\">使用前要知道</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </nav>\n    <p class=\"rail-note\">这一页把公开的套餐信息和常见疑问整理在明面上，方便你对照自己的情况做决定。</p>\n  </aside>\n\n  <main>\n    <header class=\"hero\">\n      <span class=\"hero-tag\">先把话说清楚</span>\n      <h1>Maosu</h1>\n      <div class=\"hero-lower\">\n        <p class=\"hero-lede\">挑服务这件事，其实跟挑一双常穿的鞋差不多：不必最贵，但要合脚。Maosu 在这里把<strong>套餐档位、使用步骤、客户端现状和常见疑问</strong>一次摆出来，你自己对着看，比听人转述靠谱。</p>\n        <dl class=\"hero-panel\">\n          <dt>档位数量</dt>\n          <dd>三档：基础版 / 旗舰版 / 团队版</dd>\n          <dt>计费方式</dt>\n          <dd>月付与年付两种，年付价写在表内</dd>\n          <dt>适用思路</dt>\n          <dd>先看设备数量，再看每月用量</dd>\n        </dl>\n      </div>\n    </header>\n\n    <section id=\"how\">\n      <div class=\"section-head\">\n        <span class=\"kicker\">01 / 步骤</span>\n        <h2>从看到这一页，到真正用起来</h2>\n      </div>\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"step-num\">1</span>\n          <h3>先数一下你的设备</h3>\n          <p>手机、平板、电脑、家里的电视盒子，都算。设备数量决定你该从哪一档看起，这一步比看价格更关键。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"step-num\">2</span>\n          <h3>估算每月的用量</h3>\n          <p>刷网页和看高清视频，用的量差得很远。表里每月额度以 GB 为单位，按上限写清楚，方便你对照自己的习惯。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"step-num\">3</span>\n          <h3>把两件事对上号</h3>\n          <p>设备数与用量都落进某一档的范围内，就从那一档开始。拿不准时，往小一档选，之后不够再调也比浪费好。</p>\n        </article>\n        <article class=\"step\">\n          <span class=\"step-num\">4</span>\n          <h3>按官方渠道完成开通</h3>\n          <p>本页只做展示与说明，不提供下单入口。开通、付款与账号相关的操作，请以你拿到的官方说明为准。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"plans\" class=\"band\">\n      <div class=\"section-head\">\n        <span class=\"kicker\">02 / 套餐</span>\n        <h2>三档套餐，横向摆开对比</h2>\n      </div>\n      <div class=\"table-wrap\">\n        <table>\n          价格与权益按展示内容列出；年付价为按年一次支付的金额，与月付并非同一计价单位。\n          <thead>\n            <tr>\n              <th>项目</th>\n              <th>基础版</th>\n              <th class=\"mark\">旗舰版 · 推荐</th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>价格</th>\n              <td><span class=\"price\">¥15<span class=\"price-sub\"> / 月</span></span></td>\n              <td><span class=\"price\">¥35<span class=\"price-sub\"> / 月</span></span></td>\n              <td><span class=\"price\">¥85<span class=\"price-sub\"> / 月</span></span></td>\n            </tr>\n            <tr>\n              <th>年付</th>\n              <td>¥150 / 年</td>\n              <td>¥350 / 年</td>\n              <td>¥850 / 年</td>\n            </tr>\n            <tr>\n              <th>每月流量</th>\n              <td>100 GB</td>\n              <td>300 GB</td>\n              <td>1000 GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体</th>\n              <td>基础流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n              <td>含流媒体解锁权益</td>\n            </tr>\n            <tr>\n              <th>线路与网络</th>\n              <td>普通线路节点池</td>\n              <td>IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>额外权益</th>\n              <td>—</td>\n              <td>7×24 优先工单支持</td>\n              <td>企业定制路由、专属客户经理</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>一个人用几台设备，日常浏览与轻量看片</td>\n              <td>设备稍多、在意游戏与流媒体体验的个人或小家庭</td>\n              <td>多人共用或小团队，需要统一管理与更高带宽</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"table-note\">流量额度、设备台数与线路说明均按上表展示，不额外承诺表中未列出的性能指标。若你的实际用量长期贴近某一档的上限，直接往上调一档通常更省心。</p>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"section-head\">\n        <span class=\"kicker\">03 / 客户端</span>\n        <h2>客户端这块，目前能确定什么</h2>\n      </div>\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面端</h3>\n          <p>Windows 与 macOS 的可用情况、版本号与下载地址，本页暂未获得可核实的信息。</p>\n          <p class=\"status\">状态：待官方说明</p>\n        </article>\n        <article class=\"client\">\n          <h3>移动端</h3>\n          <p>iOS 与 Android 的安装方式，各渠道可能不同，请以你收到的官方指引为准。</p>\n          <p class=\"status\">状态：待官方说明</p>\n        </article>\n        <article class=\"client\">\n          <h3>路由器与电视</h3>\n          <p>是否支持在路由器或电视设备上配置，本页不作推断，也不提供具体教程。</p>\n          <p class=\"status\">状态：待官方说明</p>\n        </article>\n        <article class=\"client\">\n          <h3>下载与安装包</h3>\n          <p>本页不放置任何下载链接。安装包请只从你确认过的官方渠道获取，避免来路不明的文件。</p>\n          <p class=\"status\">状态：本页不提供</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"care\" class=\"band\">\n      <div class=\"section-head\">\n        <span class=\"kicker\">04 / 提醒</span>\n        <h2>下单前，先把这几件事想一遍</h2>\n      </div>\n      <div class=\"grid-two\">\n        <article class=\"note-card\">\n          <h3>关于价格</h3>\n          <p>月付价与年付价是两种计费方式，年付一次性支付的金额更低，但需要你确定会用满一年。别只盯着年付的总价，先看你是否真的会长期用。</p>\n        </article>\n        <article class=\"note-card\">\n          <h3>关于流量额度</h3>\n          <p>表里写的是每月上限。正常浏览网页、收发消息通常用量不大，长时间播放高清视频会更接近上限，按自己的习惯估一估。</p>\n        </article>\n        <article class=\"note-card\">\n          <h3>关于设备数量</h3>\n          <p>同时在线设备数与可注册设备数是两回事，本页只写前者。家里设备多的话，把这个数字先对清楚再选档。</p>\n        </article>\n        <article class=\"note-card\">\n          <h3>关于我们没写的东西</h3>\n          <p>本页没有出现的项目，例如节点具体分布、测速数据、退款规则、日志策略，说明我们没有可核实的信息，因此不作描述，也不建议你按传闻去理解。</p>\n        </article>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"section-head\">\n        <span class=\"kicker\">05 / 常见问题</span>\n        <h2>你大概会想问的几个问题</h2>\n      </div>\n      <div class=\"faq-grid\">\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>三档套餐我该怎么选？</h3>\n          <p>先看两个数字：你有几台设备要同时用，以及你每月大概用多少流量。设备在 3 台以内、用量不大，基础版就够；设备到 5 台、还常看流媒体或打游戏，旗舰版更合适；多人共用或小团队，看团队版的 20 台和 1000 GB。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>年付一定比月付划算吗？</h3>\n          <p>从金额上看，年付一次性支付的总额低于十二个月的月付之和。但年付是先付后用，如果你不确定会用满一年，月付的灵活性更值得考虑。划算与否，取决于你实际使用的时长。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>流量用超了会怎样？</h3>\n          <p>本页没有可核实的超量处理规则，因此不作说明。稳妥的做法是留意自己的用量节奏，如果连续几个月都接近上限，直接换到更高一档，比临时处理更从容。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>同时在线设备数是怎么算的？</h3>\n          <p>指同一时间处于连接状态的设备数量上限，基础版 3 台、旗舰版 5 台、团队版 20 台。手机和电脑同时用就占两个名额，先按你最常见的组合来算。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>这一页可以直接下单吗？</h3>\n          <p>不能。这一页只负责把套餐、步骤和常见疑问讲清楚，不包含下单、支付或账号操作。开通请通过你手上的官方渠道进行，本页也不提供任何下载链接。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>团队版里的“定制路由”指什么？</h3>\n          <p>套餐表里列出的是企业定制路由与专属客户经理这两项权益，具体能做到什么程度、需要什么条件，本页没有可核实的信息。建议在开通前向官方渠道确认细节，别按想象去理解。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>支持哪些系统和设备？</h3>\n          <p>本页未获得可核实的客户端清单，所以不列具体系统版本。你可以在客户端区块看到当前状态说明，实际支持情况请以官方给出的信息为准。</p>\n        </article>\n        <article class=\"qa\">\n          <h3><span class=\"q\">Q</span>以后想换档位，麻烦吗？</h3>\n          <p>换档涉及计费与账号设置，本页没有相关流程的可靠信息，因此不描述操作步骤。比较稳妥的是在开通前就把档位想清楚，或直接咨询官方渠道如何处理升降档。</p>\n        </article>\n      </div>\n    </section>\n\n    <footer>\n      <strong>Maosu</strong>\n      <p>这一页的内容来自公开可用的套餐展示信息，用于帮助你比较档位与了解使用顺序。页面不构成购买承诺，也不代表任何未列出的服务能力。</p>\n    </footer>\n  </main>\n</div>",
